# 复制为 .env 并填写真实值
# cp server/.env.example server/.env

# 监听
PORT=3001
HOST=127.0.0.1

# QQ 邮箱 SMTP（注意 SMTP_PASS 是 QQ 邮箱的"授权码"，不是登录密码）
# 获取方式: https://mail.qq.com -> 设置 -> 账号 -> 开启 IMAP/SMTP -> 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=18030355222@qq.com
SMTP_PASS=请填写QQ邮箱授权码
TO_EMAIL=18030355222@qq.com

# 部署用，仅 deploy.sh 读取
DOMAIN=请填写你的域名.com
